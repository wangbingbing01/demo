def alike_phash(im1, im2):
    phash = cv2.img_hash.pHash
    h1, h2 = phash(im1), phash(im2)
    # 汉明距离 ≤ 5 几乎一模一样；≤ 10 轻微差异；> 10 明显不同。
    if cv2.norm(h1, h2, cv2.NORM_HAMMING) <= 5:
        return "alike"
    else:
        return "different"
